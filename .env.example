# ───────────── Servidor ─────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ───────────── Supabase ─────────────
# URL do seu projeto (ex: https://xxxxxxxx.supabase.co)
SUPABASE_URL=
# Service role key (Settings → API → service_role, NÃO o anon key)
SUPABASE_SERVICE_ROLE_KEY=
# (Opcional) Connection string Postgres direta — usada só por scripts/migrations/migrate-db.mjs
# Formato: postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# ───────────── Evolution API ─────────────
# Na Railway, o Evolution roda num serviço separado.
# Use a URL interna: http://<nome-do-servico>.railway.internal:8080
# Ou a URL pública: https://<seu-evolution>.up.railway.app
EVOLUTION_URL=
EVOLUTION_API_KEY=
# Nome da instância (você escolhe ao criar no Evolution Manager, ex: "agente")
EVOLUTION_INSTANCE=default

# ───────────── OpenAI ─────────────
# Obrigatório: geração de texto (gpt-4.1-mini), transcrição de áudio (whisper-1),
# análise de imagem (gpt-4o-mini). Pode também ser armazenado em agent_configs.
OPENAI_API_KEY=

# ───────────── Gemini (opcional) ─────────────
# Só necessário se você quiser analisar VÍDEOS.
# A chave é armazenada em agent_configs.gemini_api_key (não vai aqui).

# ───────────── Tunings ─────────────
# Intervalo do sweeper que reprocessa buffers travados (ms)
AGENT_BUFFER_SWEEPER_MS=20000

# ───────────── Eco cruzado WAHA (CRM) → Flora ─────────────
# Segredo compartilhado com o CRM: ele chama POST /internal/outbound-echo logo
# após cada envio automático via WAHA, pra Flora não confundir esse envio com
# mensagem manual da Mariana (mesmo número de WhatsApp, dois sistemas).
INTERNAL_ECHO_SECRET=
# 'off' reproduz o comportamento atual exato (rollback instantâneo, sem deploy).
# Só ligar depois do lado CRM também deployado e confirmando os envios.
EXTERNAL_ECHO_ENABLED=off

# ───────────── Integração de agenda com o CRM (Task 3/4, corte da Belasis) ─────────────
# docs/melhorias/2026-08-02-integracao-agenda-crm.md
# URL base do CRM (crm-operacional, produção: https://crm-studio-mariana-castro.vercel.app)
# e o MESMO segredo configurado como FLORA_API_SECRET do lado do CRM.
CRM_BASE_URL=
CRM_API_SECRET=
# Fonte de ocupação usada pela Flora: 'gcal' (padrão, Google Calendar, comportamento
# atual) | 'union' (as duas fontes, convivência pós-corte) | 'crm' (só o CRM, destino
# final). Trocar é rollback instantâneo, sem deploy.
AGENDA_SOURCE=gcal
# Só relevante com AGENDA_SOURCE=union: qual fonte é fail-closed (falha aborta a
# consulta) — a outra vira só warn e segue com o que der certo.
AGENDA_UNION_REQUIRED=crm
# 'on' consulta o CRM em paralelo (Google continua sendo a fonte real) só pra logar
# divergência — nunca muda o que a Flora oferece. Ver scripts/agenda-diff.ts.
AGENDA_SHADOW=off

# ───────────── Autenticação de origem do webhook (achado A4) ─────────────
# Sem isso, /webhooks/evolution aceita POST de qualquer um que souber a URL.
# Vazio = comportamento atual (sem checagem). Ao configurar, atualizar TAMBÉM
# a URL do webhook cadastrada no Manager da Evolution para incluir
# "?token=<mesmo valor>" — os dois lados precisam mudar juntos.
EVOLUTION_WEBHOOK_TOKEN=
